# PlanGenius AI - Environment Configuration Example
# Copy this file to .env and insert your real credentials

# Groq Cloud API Key (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=

# Server Port
PORT=5000
